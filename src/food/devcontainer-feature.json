{
    "name": "My Favorite Food",
    "id": "food",
    "version": "1.0.4",
    "description": "A feature to remind you of your favorite food",
    "options": {
        "favorite": {
            "type": "string",
            "enum": [
                "pizza",
                "donuts",
                "tacos",
                "cheeseburger"
            ],
            "default": "tacos",
            "description": "Choose your favorite food."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
